# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string

# True for local dev / local Docker Compose testing (no TLS in front of
# Nginx). Production on the Ubuntu server: False, behind Cloudflare HTTPS
# (stackfit.com) — otherwise with no TLS terminator in front,
# SECURE_SSL_REDIRECT would redirect-loop.
DEBUG=True

# Comma-separated. Required when DEBUG=False.
# Production: DJANGO_ALLOWED_HOSTS=stackfit.com,www.stackfit.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to make cross-origin requests to the API.
# Production: CORS_ALLOWED_ORIGINS=https://stackfit.com,https://www.stackfit.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated. Required when DEBUG=False and you're behind HTTPS.
CSRF_TRUSTED_ORIGINS=https://stackfit.com,https://www.stackfit.com

# --- MongoDB ---
# Local Docker Compose (this repo's docker-compose.yml "mongo" service):
MONGO_URI=mongodb://mongo:27017/
# MongoDB Atlas (cloud) instead:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=spectacle3d

# --- Email (password reset OTPs). Leave blank to print emails to console. ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
